# SmartVyapar Multi-Tenant Business ERP — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to git.

# ─────────────────────────────────────────────────────────────────
# 1. DATABASE (PostgreSQL / Neon)
# ─────────────────────────────────────────────────────────────────
# Get your Neon connection string from https://neon.tech
DATABASE_URL="postgresql://username:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/smartvyapar_db?sslmode=require"

# ─────────────────────────────────────────────────────────────────
# 2. AI — Google Gemini (AI Invoice PDF/Image Scanner)
# ─────────────────────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# ─────────────────────────────────────────────────────────────────
# 3. SECURITY
# ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use a plain-English string here — use a 64-char hex value
JWT_SECRET="replace_with_64_char_hex_from_crypto_randomBytes"

# ─────────────────────────────────────────────────────────────────
# 4. APPLICATION URL
# ─────────────────────────────────────────────────────────────────
# Development: http://localhost:3005
# Production:  https://app.yourdomain.com  ← MUST change before deploying
NEXT_PUBLIC_APP_URL="http://localhost:3005"
PORT=3005

# ─────────────────────────────────────────────────────────────────
# 5. PAYMENTS — Razorpay
# ─────────────────────────────────────────────────────────────────
# Get your keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) for development, live keys (rzp_live_...) for production
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ─────────────────────────────────────────────────────────────────
# 6. ERROR TRACKING — Sentry (optional but recommended)
# ─────────────────────────────────────────────────────────────────
# Get your DSN from https://sentry.io — create a Next.js project
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="smartvyapar"

# ─────────────────────────────────────────────────────────────────
# 7. GST E-INVOICING (NIC IRP Integration)
# ─────────────────────────────────────────────────────────────────
# Your private signing key for generating sandbox e-invoice QR codes
# Generate a strong 32-char string: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
IRP_SECRET="your_irp_private_signing_key_here"

# ─────────────────────────────────────────────────────────────────
# 8. WHATSAPP BOT WEBHOOK
# ─────────────────────────────────────────────────────────────────
# The verify token you configure in your Meta App Dashboard
# Used to verify that webhook requests actually come from Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_meta_verify_token"
